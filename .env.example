OPENAI_BASE_URL=https://api.inference.wandb.ai/v1
OPENAI_API_KEY=
OPENAI_MODEL=Qwen/Qwen3.8-27B
# random 32+ bytes, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# optional: persist orders/profiles in Vercel Blob (otherwise .data/ locally)
BLOB_READ_WRITE_TOKEN=
BLOB_ACCESS=private
# optional: comma-separated extra browser origins allowed to call /api/mcp
MCP_ALLOWED_ORIGINS=
